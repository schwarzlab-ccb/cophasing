params {
    // Input: directory containing raw segregation tables from the CoPhasing pipeline
    input_dir               = "/path/to/cophasing/test_out/"
    // Output: all pipeline results will be written to subdirectories here
    output_dir              = "/path/to/output/"
    // Analysis parameters
    cutoff                  = "10Mb"
    resolution              = 40000
    chromosomes             = "chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22"
    num_perm                = 2000
    num_workers             = 10
    pseudocount             = 0
    gaussian_kernel_size    = 1
    high_factor             = 1.8
    low_factor              = 1.8
}
